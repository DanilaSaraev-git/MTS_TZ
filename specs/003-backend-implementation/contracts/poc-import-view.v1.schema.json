{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://review-platform.local/schemas/poc-import-view.v1.schema.json",
  "title": "Feature 001 PoC v1 read-only import view",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mapping_status",
    "adapter",
    "run_id",
    "report_id",
    "sources",
    "fragments",
    "coverage",
    "findings",
    "finding_states",
    "provenance",
    "diagnostics"
  ],
  "properties": {
    "schema_version": {"const": "poc-import-view.v1"},
    "mapping_status": {"enum": ["complete", "partial"]},
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "legacy_schema_version", "legacy_run_digest"],
      "properties": {
        "id": {"const": "feature-001-poc-v1"},
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "legacy_schema_version": {"const": 1},
        "legacy_run_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "run_id": {"$ref": "#/$defs/uuid"},
    "report_id": {"$ref": "#/$defs/uuid"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/source"}
    },
    "fragments": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/fragment"}
    },
    "coverage": {"$ref": "#/$defs/coverage"},
    "findings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/finding"}
    },
    "finding_states": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/finding_state"}
    },
    "provenance": {"$ref": "#/$defs/provenance"},
    "diagnostics": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/diagnostic"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"mapping_status": {"const": "complete"}}},
      "then": {"properties": {"diagnostics": {"maxItems": 0}}},
      "else": {"properties": {"diagnostics": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "uuid": {"type": "string", "format": "uuid"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "document_id", "role", "status", "sha256", "parser", "fragment_ids"],
      "properties": {
        "source_id": {"$ref": "#/$defs/source_id"},
        "document_id": {"$ref": "#/$defs/uuid"},
        "role": {"enum": ["document", "context"]},
        "status": {"enum": ["available", "partial", "unavailable"]},
        "sha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "parser": {
          "oneOf": [
            {"$ref": "#/$defs/parser"},
            {"type": "null"}
          ]
        },
        "fragment_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/uuid"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "unavailable"}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "sha256": {"type": "null"},
              "parser": {"type": "null"},
              "fragment_ids": {"maxItems": 0}
            }
          },
          "else": {
            "properties": {
              "sha256": {"$ref": "#/$defs/sha256"},
              "parser": {"$ref": "#/$defs/parser"}
            }
          }
        }
      ]
    },
    "parser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "settings_digest"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "settings_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "fragment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_id", "document_id", "ordinal", "kind", "text", "content_sha256", "location"],
      "properties": {
        "id": {"$ref": "#/$defs/uuid"},
        "source_id": {"$ref": "#/$defs/source_id"},
        "document_id": {"$ref": "#/$defs/uuid"},
        "ordinal": {"type": "integer", "minimum": 1},
        "kind": {"enum": ["text", "table_row"]},
        "text": {"type": "string", "minLength": 1},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "location": {"$ref": "#/$defs/location"}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "target_fragment_ids", "reviewed_fragment_ids", "gaps"],
      "properties": {
        "status": {"enum": ["complete", "partial"]},
        "target_fragment_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/uuid"}
        },
        "reviewed_fragment_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/uuid"}
        },
        "gaps": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/coverage_gap"}
        }
      }
    },
    "coverage_gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "fragment_id", "code", "reason"],
      "properties": {
        "source_id": {"$ref": "#/$defs/source_id"},
        "fragment_id": {
          "oneOf": [
            {"$ref": "#/$defs/uuid"},
            {"type": "null"}
          ]
        },
        "code": {
          "enum": [
            "source_unavailable",
            "source_partial",
            "context_budget",
            "context_limit",
            "processing_failed",
            "unsupported_content",
            "other"
          ]
        },
        "reason": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "legacy_id",
        "ordinal",
        "kind",
        "title",
        "problem",
        "reason",
        "question",
        "priority",
        "anchors",
        "scope"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/uuid"},
        "legacy_id": {"type": "string", "pattern": "^F-[0-9]{3,}$"},
        "ordinal": {"type": "integer", "minimum": 1},
        "kind": {"enum": ["ambiguity", "contradiction", "missing", "inconsistency", "other"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 500},
        "problem": {"type": "string", "minLength": 1, "maxLength": 4000},
        "reason": {"type": "string", "minLength": 1, "maxLength": 4000},
        "question": {"type": "string", "minLength": 1, "maxLength": 4000},
        "priority": {"$ref": "#/$defs/priority"},
        "anchors": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/anchor"}
        },
        "scope": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/uuid"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"kind": {"const": "missing"}},
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "anchors": {"maxItems": 0},
              "scope": {"minItems": 1}
            }
          },
          "else": {"properties": {"anchors": {"minItems": 1}}}
        }
      ]
    },
    "priority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "rationale"],
      "properties": {
        "level": {"enum": ["high", "medium", "low"]},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "document_id", "fragment_id", "quote", "quote_start", "quote_end", "location"],
      "properties": {
        "source_id": {"$ref": "#/$defs/source_id"},
        "document_id": {"$ref": "#/$defs/uuid"},
        "fragment_id": {"$ref": "#/$defs/uuid"},
        "quote": {"type": "string", "minLength": 1, "maxLength": 4000},
        "quote_start": {"type": "integer", "minimum": 0},
        "quote_end": {"type": "integer", "minimum": 1},
        "location": {"$ref": "#/$defs/location"}
      }
    },
    "location": {
      "oneOf": [
        {"$ref": "#/$defs/pdf_location"},
        {"$ref": "#/$defs/text_location"}
      ]
    },
    "pdf_location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "page", "rects", "table", "row"],
      "properties": {
        "kind": {"const": "pdf"},
        "page": {"type": "integer", "minimum": 1},
        "rects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "prefixItems": [
              {"type": "number", "minimum": 0, "maximum": 1},
              {"type": "number", "minimum": 0, "maximum": 1},
              {"type": "number", "minimum": 0, "maximum": 1},
              {"type": "number", "minimum": 0, "maximum": 1}
            ],
            "items": false
          }
        },
        "table": {"type": ["integer", "null"], "minimum": 1},
        "row": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "text_location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "line_start", "line_end", "char_start", "char_end"],
      "properties": {
        "kind": {"const": "text"},
        "line_start": {"type": "integer", "minimum": 1},
        "line_end": {"type": "integer", "minimum": 1},
        "char_start": {"type": "integer", "minimum": 0},
        "char_end": {"type": "integer", "minimum": 1}
      }
    },
    "finding_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "decision_status", "decision_revision", "actor", "reason", "resolution", "decided_at"],
      "properties": {
        "finding_id": {"$ref": "#/$defs/uuid"},
        "decision_status": {"const": "unreviewed"},
        "decision_revision": {"const": 0},
        "actor": {"type": "null"},
        "reason": {"type": "null"},
        "resolution": {"type": "null"},
        "decided_at": {"type": "null"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "generation", "limitations"],
      "properties": {
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "role", "goal", "checks", "semantic_digest"],
          "properties": {
            "name": {"type": "string", "minLength": 1, "maxLength": 255},
            "version": {"type": "string", "minLength": 1, "maxLength": 64},
            "role": {"type": "string", "minLength": 1, "maxLength": 2000},
            "goal": {"type": "string", "minLength": 1, "maxLength": 2000},
            "checks": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1, "maxLength": 1000}
            },
            "semantic_digest": {"$ref": "#/$defs/sha256"}
          }
        },
        "generation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "agent", "model", "model_version"],
          "properties": {
            "mode": {"enum": ["deterministic_legacy", "agent", "unknown"]},
            "agent": {"type": "string", "minLength": 1, "maxLength": 255},
            "model": {"type": "string", "minLength": 1, "maxLength": 255},
            "model_version": {"type": "string", "minLength": 1, "maxLength": 255}
          }
        },
        "limitations": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 2000}
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "entity_kind", "entity_id", "message"],
      "properties": {
        "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,127}$"},
        "entity_kind": {"enum": ["run", "source", "fragment", "finding", "human_state"]},
        "entity_id": {"type": ["string", "null"], "maxLength": 160},
        "message": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    }
  }
}
