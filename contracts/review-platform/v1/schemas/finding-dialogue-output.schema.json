{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://review-data-spec.local/contracts/finding-dialogue-output.v1.schema.json",
  "title": "Finding dialogue skill output v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "run_id", "dialogue_id", "turn_id", "assistant_message"],
  "properties": {
    "contract_version": {"const": "finding-dialogue-output.v1"},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "dialogue_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "turn_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "assistant_message": {"$ref": "#/$defs/assistant_message"}
  },
  "$defs": {
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "fragment_id", "quote", "quote_start", "quote_end"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "fragment_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "quote": {"type": "string", "minLength": 1, "maxLength": 4000},
        "quote_start": {"type": "integer", "minimum": 0},
        "quote_end": {"type": "integer", "minimum": 1}
      }
    },
    "assistant_message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "content", "proposed_resolution", "anchors"],
      "properties": {
        "action": {"enum": ["clarify", "propose_resolution", "escalate"]},
        "content": {"type": "string", "minLength": 1, "maxLength": 4000},
        "proposed_resolution": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/proposed_resolution"}
          ]
        },
        "anchors": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/anchor"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"action": {"const": "propose_resolution"}},
            "required": ["action"]
          },
          "then": {"properties": {"proposed_resolution": {"$ref": "#/$defs/proposed_resolution"}}},
          "else": {"properties": {"proposed_resolution": {"type": "null"}}}
        }
      ]
    },
    "proposed_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "rationale"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 8000},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 4000}
      }
    }
  }
}
