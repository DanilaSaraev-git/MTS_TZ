{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://review-data-spec.local/contracts/review-input.v1.schema.json",
  "title": "Review skill input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "run_id",
    "document_source_id",
    "sources",
    "review_scope",
    "profile",
    "options"
  ],
  "properties": {
    "contract_version": {"const": "review-input.v1"},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "document_source_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "review_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_fragment_ids"],
      "properties": {
        "target_fragment_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 160}
        }
      }
    },
    "profile": {"$ref": "#/$defs/profile"},
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locale", "max_findings"],
      "properties": {
        "locale": {"type": "string", "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"},
        "max_findings": {"type": "integer", "minimum": 1, "maximum": 500}
      }
    }
  },
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page": {"type": "integer", "minimum": 1},
        "line_start": {"type": "integer", "minimum": 1},
        "line_end": {"type": "integer", "minimum": 1},
        "table": {"type": "integer", "minimum": 1},
        "row": {"type": "integer", "minimum": 1},
        "bbox": {
          "type": "array",
          "prefixItems": [
            {"type": "number"},
            {"type": "number"},
            {"type": "number"},
            {"type": "number"}
          ],
          "items": false
        }
      },
      "anyOf": [
        {"required": ["page"]},
        {"required": ["line_start", "line_end"]}
      ]
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "enum": [
            "not_found",
            "unsupported_media_type",
            "encrypted",
            "ocr_required",
            "empty_content",
            "extraction_partial",
            "extraction_failed",
            "other"
          ]
        },
        "message": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "fragment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "text", "location"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 160},
        "kind": {"enum": ["text", "table_row"]},
        "text": {"type": "string", "minLength": 1},
        "location": {"$ref": "#/$defs/location"},
        "cells": {
          "type": "array",
          "minItems": 1,
          "items": {"type": ["string", "null"]}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"kind": {"const": "table_row"}},
            "required": ["kind"]
          },
          "then": {"required": ["cells"]},
          "else": {"not": {"required": ["cells"]}}
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "name",
        "media_type",
        "sha256",
        "status",
        "diagnostics",
        "fragments"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "role": {"enum": ["document", "context"]},
        "name": {"type": "string", "minLength": 1, "maxLength": 255},
        "media_type": {"type": "string", "minLength": 1, "maxLength": 127},
        "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "status": {"enum": ["available", "partial", "unavailable"]},
        "diagnostics": {
          "type": "array",
          "items": {"$ref": "#/$defs/diagnostic"}
        },
        "fragments": {
          "type": "array",
          "items": {"$ref": "#/$defs/fragment"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "available"}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "sha256": {"type": "string"},
              "diagnostics": {"maxItems": 0},
              "fragments": {"minItems": 1}
            }
          }
        },
        {
          "if": {
            "properties": {"status": {"const": "partial"}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "sha256": {"type": "string"},
              "diagnostics": {"minItems": 1},
              "fragments": {"minItems": 1}
            }
          }
        },
        {
          "if": {
            "properties": {"status": {"const": "unavailable"}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "diagnostics": {"minItems": 1},
              "fragments": {"maxItems": 0}
            }
          }
        }
      ]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "name", "role", "goal", "checks"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 255},
        "role": {"type": "string", "minLength": 1, "maxLength": 500},
        "goal": {"type": "string", "minLength": 1, "maxLength": 2000},
        "checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    }
  }
}
