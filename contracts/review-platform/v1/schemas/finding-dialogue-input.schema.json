{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://review-data-spec.local/contracts/finding-dialogue-input.v1.schema.json",
  "title": "Finding dialogue skill input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "run_id",
    "dialogue_id",
    "finding",
    "sources",
    "profile",
    "history",
    "current_turn",
    "options"
  ],
  "properties": {
    "contract_version": {"const": "finding-dialogue-input.v1"},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "dialogue_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "finding": {"$ref": "#/$defs/finding"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "profile": {"$ref": "#/$defs/profile"},
    "history": {
      "type": "array",
      "items": {"$ref": "#/$defs/completed_turn"}
    },
    "current_turn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turn_id", "ordinal", "member_message", "follow_up_allowed"],
      "properties": {
        "turn_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "ordinal": {"type": "integer", "minimum": 1},
        "member_message": {"$ref": "#/$defs/member_message"},
        "follow_up_allowed": {"type": "boolean"}
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locale"],
      "properties": {
        "locale": {"type": "string", "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"}
      }
    }
  },
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page": {"type": "integer", "minimum": 1},
        "line_start": {"type": "integer", "minimum": 1},
        "line_end": {"type": "integer", "minimum": 1},
        "table": {"type": "integer", "minimum": 1},
        "row": {"type": "integer", "minimum": 1},
        "bbox": {
          "type": "array",
          "prefixItems": [
            {"type": "number"},
            {"type": "number"},
            {"type": "number"},
            {"type": "number"}
          ],
          "items": false
        }
      },
      "anyOf": [
        {"required": ["page"]},
        {"required": ["line_start", "line_end"]}
      ]
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "enum": [
            "not_found",
            "unsupported_media_type",
            "encrypted",
            "ocr_required",
            "empty_content",
            "extraction_partial",
            "extraction_failed",
            "other"
          ]
        },
        "message": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "fragment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "text", "location"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 160},
        "kind": {"enum": ["text", "table_row"]},
        "text": {"type": "string", "minLength": 1},
        "location": {"$ref": "#/$defs/location"},
        "cells": {
          "type": "array",
          "minItems": 1,
          "items": {"type": ["string", "null"]}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"kind": {"const": "table_row"}},
            "required": ["kind"]
          },
          "then": {"required": ["cells"]},
          "else": {"not": {"required": ["cells"]}}
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "name",
        "media_type",
        "sha256",
        "status",
        "diagnostics",
        "fragments"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "role": {"enum": ["document", "context"]},
        "name": {"type": "string", "minLength": 1, "maxLength": 255},
        "media_type": {"type": "string", "minLength": 1, "maxLength": 127},
        "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "status": {"enum": ["available", "partial", "unavailable"]},
        "diagnostics": {
          "type": "array",
          "items": {"$ref": "#/$defs/diagnostic"}
        },
        "fragments": {
          "type": "array",
          "items": {"$ref": "#/$defs/fragment"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "available"}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "sha256": {"type": "string"},
              "diagnostics": {"maxItems": 0},
              "fragments": {"minItems": 1}
            }
          }
        },
        {
          "if": {
            "properties": {"status": {"const": "partial"}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "sha256": {"type": "string"},
              "diagnostics": {"minItems": 1},
              "fragments": {"minItems": 1}
            }
          }
        },
        {
          "if": {
            "properties": {"status": {"const": "unavailable"}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "diagnostics": {"minItems": 1},
              "fragments": {"maxItems": 0}
            }
          }
        }
      ]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "name", "role", "goal", "checks"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 255},
        "role": {"type": "string", "minLength": 1, "maxLength": 500},
        "goal": {"type": "string", "minLength": 1, "maxLength": 2000},
        "checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "fragment_id", "quote", "quote_start", "quote_end"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "fragment_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "quote": {"type": "string", "minLength": 1, "maxLength": 4000},
        "quote_start": {"type": "integer", "minimum": 0},
        "quote_end": {"type": "integer", "minimum": 1}
      }
    },
    "priority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "rationale"],
      "properties": {
        "level": {"enum": ["high", "medium", "low"]},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ordinal",
        "kind",
        "title",
        "problem",
        "reason",
        "question",
        "priority",
        "anchors",
        "scope"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "ordinal": {"type": "integer", "minimum": 1},
        "kind": {"enum": ["ambiguity", "contradiction", "missing", "inconsistency", "other"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 500},
        "problem": {"type": "string", "minLength": 1, "maxLength": 4000},
        "reason": {"type": "string", "minLength": 1, "maxLength": 4000},
        "question": {"type": "string", "minLength": 1, "maxLength": 4000},
        "priority": {"$ref": "#/$defs/priority"},
        "anchors": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/anchor"}
        },
        "scope": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 160}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"kind": {"const": "missing"}},
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "anchors": {"maxItems": 0},
              "scope": {"minItems": 1}
            }
          },
          "else": {"properties": {"anchors": {"minItems": 1}}}
        }
      ]
    },
    "member_message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message_id", "content"],
      "properties": {
        "message_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "content": {"type": "string", "minLength": 1, "maxLength": 8000}
      }
    },
    "assistant_message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message_id", "action", "content", "proposed_resolution", "anchors"],
      "properties": {
        "message_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "action": {"enum": ["clarify", "propose_resolution", "escalate"]},
        "content": {"type": "string", "minLength": 1, "maxLength": 4000},
        "proposed_resolution": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/proposed_resolution"}
          ]
        },
        "anchors": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/anchor"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"action": {"const": "propose_resolution"}},
            "required": ["action"]
          },
          "then": {"properties": {"proposed_resolution": {"$ref": "#/$defs/proposed_resolution"}}},
          "else": {"properties": {"proposed_resolution": {"type": "null"}}}
        }
      ]
    },
    "proposed_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "rationale"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 8000},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 4000}
      }
    },
    "completed_turn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turn_id", "ordinal", "member_message", "assistant_message"],
      "properties": {
        "turn_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "ordinal": {"type": "integer", "minimum": 1},
        "member_message": {"$ref": "#/$defs/member_message"},
        "assistant_message": {"$ref": "#/$defs/assistant_message"}
      }
    }
  }
}
