    "finding":{"type":"object","additionalProperties":false,"required":["id","kind","title","problem","reason","question","priority","priority_reason","status","human_review","anchors","scope"],"properties":{"id":{"type":"string","pattern":"^F-[0-9]{3,}$"},"kind":{"enum":["ambiguity","contradiction","missing","inconsistency","other"]},"title":{"type":"string","minLength":1},"problem":{"type":"string","minLength":1},"reason":{"type":"string","minLength":1},"question":{"type":"string","minLength":1},"priority":{"enum":["high","medium","low"]},"priority_reason":{"type":"string","minLength":1},"status":{"enum":["unreviewed","confirmed","rejected","needs_context"]},"human_review":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/human"}]},"anchors":{"type":"array","items":{"$ref":"#/$defs/anchor"}},"scope":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}}}
